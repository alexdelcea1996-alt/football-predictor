# Environment variables for Football Predictor

# API Keys (optional - can use CSV data without these)
FP_API_SPORTMONKS_API_KEY=
FP_API_API_FOOTBALL_KEY=

# Paths (optional - defaults to current directory)
# FP_DATA_DIR=./data
# FP_MODELS_DIR=./models
# FP_CACHE_DIR=./.cache

# Feature Engineering Parameters
# FP_FEATURE_ROLLING_WINDOWS=[5,10,20]
# FP_FEATURE_ELO_K_FACTOR=20
# FP_FEATURE_DECAY_FACTOR=0.95
# FP_FEATURE_H2H_LOOKBACK_MATCHES=5

# Model Parameters
# FP_MODEL_CV_FOLDS=5
# FP_MODEL_EARLY_STOPPING_ROUNDS=50
# FP_MODEL_OPTUNA_N_TRIALS=100

# Logging
# FP_LOG_LEVEL=INFO
